# Copy this file to .env. Do not commit .env or the master-key file.
# Path on the Windows host to a private file containing one base64 32-byte key.
WF_SECRET_KEY_HOST_PATH=
# Argon2id PHC password hash. Keep the plaintext password out of this file.
WF_AUTH_PASSWORD_HASH=
# Exact local endpoints accessible to approved addons; never use wildcards.
WF_ADDON_NETWORK_PRIVATE_TARGETS=http://host.docker.internal:5201/patrimonio/v4,http://host.docker.internal:5301/patrimonio/v4
# Agenda das importações do CB e do CRV, em America/Sao_Paulo. Este é o
# padrão do Compose e tem precedência sobre o intervalo legado abaixo.
WF_PATRIMONIO_SYNC_CRON=0 8,14 * * 1-5
# Alternativa legada quando WF_PATRIMONIO_SYNC_CRON estiver vazio: intervalo em
# segundos (900 é o padrão; 0 desliga). Com o cron acima, este valor é ignorado.
WF_PATRIMONIO_SYNC_INTERVAL_SECS=900
