{
  "id": "controle-patrimonial-sync",
  "name": "Controle Patrimonial",
  "version": "0.4.1",
  "description": "Shows the server-side CB and CRV import and keeps a local read-only copy of the source records.",
  "author": "MSPA",
  "main": "dist/addon.js",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.0",
  "enabled": true,
  "contributes": {
    "routes": [{ "id": "controle-patrimonial-sync" }],
    "links": { "sidebar": [{ "id": "controle-patrimonial-sync", "route": "controle-patrimonial-sync", "label": "Controle Patrimonial", "icon": "arrows-clockwise", "order": 90 }] }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "network": { "allowedHosts": ["host.docker.internal", "cb-api", "crv-api"] },
  "permissions": [
    { "category": "secrets", "functions": ["set", "use"], "purpose": "Store each source Bearer token in the secret vault and use it only to authenticate read-only API requests." },
    { "category": "network", "functions": ["request"], "purpose": "Read the explicitly approved local CB and CRV v4 APIs." }
  ],
  "keywords": ["wealthfolio", "controle-bancario", "controle-renda-variavel"],
  "license": "MIT"
}
