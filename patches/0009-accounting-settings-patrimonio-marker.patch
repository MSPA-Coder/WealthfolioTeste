         }
     }
 
+    /// The CB/CRV import marks its accounts with a plain-text meta; they take
+    /// the defaults instead of being refused as unreadable.
+    #[test]
+    fn patrimonio_import_marker_reads_as_the_defaults() {
+        for meta in [
+            "controlePatrimonial:cb:account:1",
+            "controlePatrimonial:crv:xp:principal:BRL",
+        ] {
+            let settings = accounting_settings_of(Some(meta))
+                .unwrap_or_else(|error| panic!("{meta:?}: {error}"));
+            assert_eq!(
+                settings.cost_basis_method,
+                AccountAccountingSettings::default_for_account("acc").cost_basis_method
+            );
+        }
+        assert!(accounting_settings_of(Some("otherPlainText")).is_err());
+    }
+
     /// Engine rules R7.2: settings this version cannot read are an error for
     /// their account, never the defaults.
     #[test]
