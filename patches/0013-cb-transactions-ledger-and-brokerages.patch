+    #[test]
+    fn the_opening_day_reading_is_the_one_that_reproduces_the_balance() {
+        let initial = dec("100");
+        let opening = day("2025-12-31");
+        let movements = vec![(opening, dec("10")), (day("2026-01-05"), dec("-30"))];
+        // Entries of the opening day come on top of the opening balance.
+        assert_eq!(
+            opening_day_reading(initial, opening, &movements, day("2026-02-01"), dec("80")),
+            Some(true)
+        );
+        // Entries of the opening day are already inside it.
+        assert_eq!(
+            opening_day_reading(initial, opening, &movements, day("2026-02-01"), dec("70")),
+            Some(false)
+        );
+        assert_eq!(
+            opening_day_reading(initial, opening, &movements, day("2026-02-01"), dec("999")),
+            None
+        );
+        // A later entry is not part of the balance of an earlier day.
+        assert_eq!(
+            opening_day_reading(initial, opening, &movements, day("2026-01-01"), dec("110")),
+            Some(true)
+        );
+    }
