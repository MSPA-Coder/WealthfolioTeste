+// ---------------------------------------------------------------------------
+
+fn category_id(taxonomy: &str, cb_category_id: &str) -> String {
+    format!("cb_{}", short_hash(&format!("{taxonomy}:{cb_category_id}")))
+}
+
+/// Makes sure every CB category in use exists in the matching taxonomy, under a
+/// stable id, and returns the Wealthfolio id of each (taxonomy, CB category).
+async fn ensure_categories(
+    state: &AppState,
+    wanted: &BTreeMap<(&'static str, String), String>,
+) -> HashMap<(&'static str, String), String> {
+    let mut resolved = HashMap::new();
+    for taxonomy in [SPENDING_TAXONOMY, INCOME_TAXONOMY] {
+        let existing: BTreeSet<String> = match state.taxonomy_service.get_taxonomy(taxonomy) {
+            Ok(Some(found)) => found
+                .categories
+                .into_iter()
+                .map(|category| category.id)
+                .collect(),
+            _ => {
+                tracing::warn!("Patrimonio sync: taxonomy {taxonomy} not found; categories skipped");
+                continue;
+            }
+        };
+        let mut index = 0;
+        for ((wanted_taxonomy, cb_id), name) in wanted {
+            if *wanted_taxonomy != taxonomy {
+                continue;
+            }
+            let id = category_id(taxonomy, cb_id);
+            index += 1;
+            if !existing.contains(&id) {
+                let created = state
+                    .taxonomy_service
+                    .create_category(NewCategory {
+                        id: Some(id.clone()),
+                        taxonomy_id: taxonomy.to_string(),
+                        parent_id: None,
+                        name: name.clone(),
+                        key: id.clone(),
+                        color: CATEGORY_COLORS[index % CATEGORY_COLORS.len()].to_string(),
+                        description: Some("Categoria do Controle Bancário".to_string()),
+                        sort_order: 1000 + index as i32,
+                        icon: None,
+                    })
+                    .await;
+                if created.is_err() {
+                    tracing::warn!("Patrimonio sync: could not create one CB category");
+                    continue;
+                }
+            }
+            resolved.insert((taxonomy, cb_id.clone()), id);
+        }
+    }
+    resolved
+}
+
+/// Labels the CB activities with their CB category. Best effort: an activity
+/// that already has a category (the operator's choice wins) or whose account is
+/// outside the Spending scope is left alone.
+async fn assign_categories(state: &AppState, desired: &[Desired], managed: &BTreeSet<String>) {
+    let settings = match state.spending_settings_service.get().await {
+        Ok(settings) if settings.enabled => settings,
+        _ => return,
+    };
+    let wanted: BTreeMap<(&'static str, String), String> = desired
+        .iter()
+        .filter(|item| settings.account_ids.contains(&item.account_id))
+        .filter_map(|item| item.category.clone())
+        .map(|(taxonomy, id, name)| ((taxonomy, id), name))
+        .collect();
+    if wanted.is_empty() {
+        return;
+    }
+    let resolved = ensure_categories(state, &wanted).await;
+    let Ok(activities) = cb_activities(state, managed) else {
+        return;
+    };
+    let ids: HashMap<String, String> = activities
+        .into_iter()
+        .filter_map(|activity| Some((activity.idempotency_key?, activity.id)))
+        .collect();
+    let candidate_ids: Vec<String> = desired
+        .iter()
+        .filter(|item| item.category.is_some())
+        .filter_map(|item| ids.get(&item.key).cloned())
+        .collect();
+    let mut labelled: BTreeSet<String> = BTreeSet::new();
+    for chunk in candidate_ids.chunks(BULK_CHUNK) {
+        if let Ok(rows) = state.cash_activity_service.get_by_activity_ids(chunk).await {
+            for row in rows {
+                if !row.assignments.is_empty() {
+                    labelled.insert(row.activity.id);
+                }
+            }
+        }
+    }
+    let mut assignments: Vec<BulkCategoryAssignment> = Vec::new();
+    for item in desired {
+        let Some((taxonomy, cb_id, _)) = &item.category else {
+            continue;
+        };
+        let (Some(activity_id), Some(category)) =
+            (ids.get(&item.key), resolved.get(&(*taxonomy, cb_id.clone())))
+        else {
+            continue;
+        };
+        if labelled.contains(activity_id) {
+            continue;
+        }
+        assignments.push(BulkCategoryAssignment {
+            activity_id: activity_id.clone(),
+            taxonomy_id: taxonomy.to_string(),
+            category_id: category.clone(),
+        });
+    }
+    let mut applied = 0;
+    for chunk in assignments.chunks(BULK_CHUNK) {
+        match state.cash_activity_service.bulk_assign_categories(chunk).await {
+            Ok(done) => applied += done.len(),
+            Err(_) => {
+                // One rejected row rejects the batch: retry row by row.
+                for one in chunk {
+                    if state
+                        .cash_activity_service
+                        .bulk_assign_categories(std::slice::from_ref(one))
+                        .await
+                        .is_ok()
+                    {
+                        applied += 1;
+                    }
+                }
+            }
+        }
+    }
+    if applied > 0 {
+        tracing::info!("Patrimonio sync: CB categories assigned={applied}");
+    }
+}
