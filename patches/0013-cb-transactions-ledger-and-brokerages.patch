+    #[test]
+    fn a_ledger_that_reproduces_the_balance_adds_up_to_it() {
+        let items: Vec<Value> = serde_json::from_str(
+            r#"[
+              {"resource":"category","source_id":"c-g","payload":{"source_id":"c-g","name":"Supermercado"}},
+              {"resource":"category","source_id":"c-i","payload":{"source_id":"c-i","name":"DBR"}},
+              {"resource":"category","source_id":"c-t","payload":{"source_id":"c-t","name":"Transferência Entre Contas"}},
+              {"resource":"cash_entry","source_id":"e1","payload":{"account_id":"a","category_id":"c-g","category_kind":"gerencial","status":"realizado","entry_type":"despesa","realized_date":"2026-01-10","realized_amount":"250.40","currency":"BRL","description":"Mercado"}},
+              {"resource":"cash_entry","source_id":"e2","payload":{"account_id":"a","category_id":"c-i","category_kind":"gerencial","status":"realizado","entry_type":"receita","realized_date":"2026-01-12","realized_amount":"1000.00","currency":"BRL","description":"Pagamento"}},
+              {"resource":"cash_entry","source_id":"e3","payload":{"account_id":"a","category_id":"c-t","category_kind":"transferencia","transfer_id":"t1","status":"realizado","entry_type":"despesa","realized_date":"2026-01-15","realized_amount":"300.00","currency":"BRL","description":"Pix"}},
+              {"resource":"cash_entry","source_id":"e4","payload":{"account_id":"a","category_id":"c-g","category_kind":"gerencial","status":"a_vencer","entry_type":"despesa","realized_date":null,"realized_amount":null,"currency":"BRL","description":"Previsto"}},
+              {"resource":"cash_entry","source_id":"e5","payload":{"account_id":"b","category_id":"c-g","category_kind":"gerencial","status":"realizado","entry_type":"despesa","realized_date":"2026-01-11","realized_amount":"7.00","currency":"BRL","description":"Outra conta"}}
+            ]"#,
+        )
+        .unwrap();
+        let categories = parse_categories(&items);
+        let entries = parse_ledger_entries(&items);
+        assert_eq!(entries.len(), 4, "only realized entries");
+
+        let mut account = cb_account(CbKind::Checking, "100.00");
+        account.source_id = "a".into();
+        let movements = realized_movements(&items, "a");
+        let balance = dec("100.00") - dec("250.40") + dec("1000.00") - dec("300.00");
+        let include_opening_day = opening_day_reading(
+            dec("100.00"),
+            day("2025-12-31"),
+            &movements,
+            day("2026-01-31"),
+            balance,
+        )
+        .expect("the ledger reproduces the balance");
+        assert!(!include_opening_day);
+
+        let selected: Vec<&LedgerEntry> = entries
+            .iter()
+            .filter(|entry| entry.account == "a" && entry.date > day("2025-12-31"))
+            .collect();
+        let paired = paired_transfer_groups(&selected);
+        let mut desired =
+            vec![opening_activity(&account, "wf", dec("100.00"), day("2025-12-31")).unwrap()];
+        for entry in &selected {
+            let group = entry.transfer_like.then(|| {
+                let id = entry.transfer_id.clone().unwrap_or_else(|| entry.key.clone());
+                let external = !paired.contains(&id);
+                (id, external)
+            });
+            let name = categories[&entry.category_id].name.as_str();
+            desired.push(entry_activity(entry, CbKind::Checking, "wf", name, group));
+        }
+        let total: Decimal = desired.iter().map(cash_effect).sum();
+        assert_eq!(total, balance);
+        assert_eq!(desired.len(), 4);
+    }
