+    #[test]
+    fn only_a_real_pair_is_linked() {
+        let mut out = entry("t-out", false, true, "100.00", "Pix");
+        out.transfer_id = Some("t".into());
+        let mut inn = entry("t-in", true, true, "100.00", "Pix");
+        inn.account = "controle-bancario:account:2".into();
+        inn.transfer_id = Some("t".into());
+        assert_eq!(
+            paired_transfer_groups(&[&out, &inn]),
+            BTreeSet::from(["t".to_string()])
+        );
+        // The other leg is outside the ledger.
+        assert!(paired_transfer_groups(&[&out]).is_empty());
+        // Same account on both legs, or different amounts: not a pair.
+        let mut same_account = inn.clone();
+        same_account.account = out.account.clone();
+        assert!(paired_transfer_groups(&[&out, &same_account]).is_empty());
+        let mut other_amount = inn.clone();
+        other_amount.amount = dec("99.00");
+        assert!(paired_transfer_groups(&[&out, &other_amount]).is_empty());
+        // A gerencial entry never joins a group.
+        let mut gerencial = inn;
+        gerencial.transfer_like = false;
+        assert!(paired_transfer_groups(&[&out, &gerencial]).is_empty());
+    }
