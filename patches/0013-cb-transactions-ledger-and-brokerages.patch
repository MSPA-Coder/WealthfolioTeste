+struct BrokerGroup {
+    marker_source_id: String,
+    display: String,
+    currency: String,
+    positions: Vec<ManualHoldingInput>,
+    crv_holdings: usize,
+    cb_accounts: Vec<CbAccount>,
+}
+
+pub(super) struct CrvGroup {
+    pub account: String,
+    pub account_name: String,
+    pub portfolio: String,
+    pub currency: String,
+    pub positions: Vec<ManualHoldingInput>,
+}
+
+/// One entry per (CRV account, portfolio, currency), as the add-on always grouped them.
+pub(super) fn parse_crv_groups(snapshot: &Value) -> Result<(NaiveDate, Vec<CrvGroup>, usize), String> {
+    let holdings = snapshot
+        .get("holdings")
+        .and_then(Value::as_array)
+        .ok_or_else(|| "Snapshot CRV v4 inválido: posições ausentes.".to_string())?;
+    // CRV declares the pilot as real, open equities only. Without a complete
+    // declaration nothing is applied and nothing is cleared.
+    if snapshot
+        .get("coverage")
+        .and_then(|coverage| coverage.get("holdings"))
+        .and_then(|holdings| holdings.get("complete"))
+        .and_then(Value::as_bool)
+        != Some(true)
+    {
+        return Err("Snapshot CRV v4 inválido: cobertura de posições incompleta.".into());
+    }
+    let date = snapshot
+        .get("data_de_referencia")
+        .and_then(Value::as_str)
+        .or_else(|| snapshot.get("snapshot_as_of").and_then(Value::as_str))
+        .ok_or_else(|| "Snapshot CRV v4 inválido: data de referência ausente.".to_string())?;
+    let date = NaiveDate::parse_from_str(date, "%Y-%m-%d")
+        .map_err(|_| "Snapshot CRV v4 inválido: data de referência ausente.".to_string())?;
+
+    let mut groups: BTreeMap<String, CrvGroup> = BTreeMap::new();
+    for holding in holdings {
+        if holding.get("instrument_type").and_then(Value::as_str) != Some("equity") {
+            return Err("Snapshot CRV v4 contém instrumento fora do escopo de ações.".into());
+        }
+        let account = required_string(holding, "account", "conta da posição CRV")?;
+        let portfolio = required_string(holding, "portfolio", "carteira da posição CRV")?;
+        let account_name = required_string(holding, "account_name", "nome da conta CRV")?;
+        let symbol = required_string(holding, "instrument", "instrumento CRV")?;
+        let currency = required_string(holding, "currency", "moeda da posição CRV")?;
+        let market = holding
+            .get("market")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        let quantity = parse_decimal_field(holding, "quantity", "quantidade CRV")?;
+        let average_cost = parse_decimal_field(holding, "average_cost", "custo médio CRV")?;
+        let group = groups
+            .entry(format!("{account}:{portfolio}:{currency}"))
+            .or_insert_with(|| CrvGroup {
+                account: account.to_string(),
+                account_name: account_name.to_string(),
+                portfolio: portfolio.to_string(),
+                currency: currency.to_string(),
+                positions: Vec::new(),
+            });
+        group.positions.push(crv_holding_input(
+            symbol,
+            market_to_mic(market),
+            currency,
+            quantity,
+            average_cost,
+        ));
+    }
+    Ok((date, groups.into_values().collect(), holdings.len()))
+}
+
+/// What the brokerage pass produced, for the caller's counters and for income.
+pub(super) struct BrokerageOutcome {
+    pub accounts: usize,
+    pub snapshots: usize,
+    pub holdings: usize,
+    /// CB brokerage account → Wealthfolio account that now represents it.
+    pub account_map: HashMap<String, String>,
+}
+
+pub(super) async fn sync_brokerages(
+    state: &AppState,
+    cb_snapshot: &Value,
+    crv_snapshot: &Value,
+    today: &str,
+) -> Result<BrokerageOutcome, String> {
+    let items = validate_cb_snapshot(cb_snapshot)?;
+    let (crv_date, crv_groups, holdings) = parse_crv_groups(crv_snapshot)?;
+    let cb_accounts: Vec<CbAccount> = parse_cb_accounts(items)?
+        .into_iter()
+        .filter(|account| account.brokerage)
+        .collect();
+
+    let mut groups: BTreeMap<(String, String), BrokerGroup> = BTreeMap::new();
+    for crv in crv_groups {
+        let key = broker_key(&crv.account);
+        let group = groups
+            .entry((key.clone(), crv.currency.clone()))
+            .or_insert_with(|| BrokerGroup {
+                marker_source_id: format!(
+                    "{CRV_ACCOUNT_PREFIX}{}:{}:{}",
+                    crv.account, crv.portfolio, crv.currency
+                ),
+                display: broker_display(&key, &crv.account_name),
+                currency: crv.currency.clone(),
+                positions: Vec::new(),
+                crv_holdings: 0,
+                cb_accounts: Vec::new(),
+            });
+        group.crv_holdings += crv.positions.len();
+        group.positions.extend(crv.positions);
+    }
+    for account in cb_accounts {
+        let key = broker_key(&account.institution);
+        let currency = account.currency.clone();
+        groups
+            .entry((key.clone(), currency.clone()))
+            .or_insert_with(|| BrokerGroup {
+                marker_source_id: format!("{CRV_ACCOUNT_PREFIX}{key}:{currency}:{currency}"),
+                display: broker_display(&key, &account.institution),
+                currency: currency.clone(),
+                positions: Vec::new(),
+                crv_holdings: 0,
+                cb_accounts: Vec::new(),
+            })
+            .cb_accounts
+            .push(account);
+    }
+
+    let reference_date = cb_snapshot
+        .get("snapshot_as_of")
+        .and_then(Value::as_str)
+        .map(str::to_string);
+    let mut outcome = BrokerageOutcome {
+        accounts: 0,
+        snapshots: 0,
+        holdings,
+        account_map: HashMap::new(),
+    };
+    let mut active = BTreeSet::new();
+    for group in groups.into_values() {
+        active.insert(marker(&group.marker_source_id));
+        let account = ensure_source_account(
+            state,
+            &AccountSpec {
+                marker: marker(&group.marker_source_id),
+                provider: CRV_PROVIDER,
+                provider_account_id: &group.marker_source_id,
+                name: format!("{} · {}", group.display, group.currency),
+                currency: &group.currency,
+                account_type: account_types::SECURITIES,
+                group: Some(GROUP_BROKERAGE),
+                tracking_mode: TrackingMode::Holdings,
+            },
+        )
+        .await?;
+        outcome.accounts += 1;
+
+        // The CB publishes the cash; a missing balance is never a zero balance.
+        let mut cash: Option<Decimal> = None;
+        let mut cash_date: Option<NaiveDate> = None;
+        for cb in &group.cb_accounts {
+            outcome
+                .account_map
+                .insert(cb.source_id.clone(), account.id.clone());
+            let Some(balance) = cb.balance else { continue };
+            let date = reference_date
+                .clone()
+                .or_else(|| cb.balance_as_of.clone())
+                .unwrap_or_else(|| today.to_string());
+            let date = NaiveDate::parse_from_str(&date, "%Y-%m-%d")
+                .map_err(|_| "Conta CB v4 inválida: data do saldo ausente.".to_string())?;
+            cash = Some(cash.unwrap_or(Decimal::ZERO) + balance);
+            cash_date = Some(cash_date.map_or(date, |current| current.max(date)));
+            if group.cb_accounts.len() == 1 {
+                if let (Some(initial), Some(initial_date)) = (cb.initial, cb.initial_date) {
+                    let movements = realized_movements(items, &cb.source_id);
+                    match balance_history(initial, initial_date, &movements, date, balance) {
+                        Some(series) => {
+                            outcome.snapshots += backfill_cb_history(
+                                state,
+                                &account.id,
+                                &account.currency,
+                                &format!("{}>{}", cb.source_id, account.id),
+                                &series,
+                            )
+                            .await?;
+                        }
+                        None => tracing::warn!(
+                            "Patrimonio sync: CB history does not reproduce the published balance; only today is written"
+                        ),
+                    }
+                }
+            }
+        }
+        if cash.is_none() && group.positions.is_empty() {
+            continue;
+        }
+        let snapshot_date = match (cash_date, group.crv_holdings > 0) {
+            (Some(cash_date), true) => cash_date.max(crv_date),
+            (Some(cash_date), false) => cash_date,
+            (None, _) => crv_date,
+        };
+        save_source_snapshot(
+            state,
+            &account.id,
+            &account.currency,
+            snapshot_date,
+            group.positions,
+            cash.map(|amount| {
+                vec![CashBalanceInput {
+                    currency: group.currency.clone(),
+                    amount,
+                }]
+            })
+            .unwrap_or_default(),
+        )
+        .await?;
+        outcome.snapshots += 1;
+    }
+
+    // The old per-source accounts of these brokerages (cash-only, named after
+    // the CB account) are replaced: archived, never deleted.
+    for cb_source_id in outcome.account_map.keys() {
+        let wanted = marker(cb_source_id);
+        for old in accounts_with_marker_prefix(state, &marker(CB_ACCOUNT_PREFIX))? {
+            if old.meta.as_deref() == Some(wanted.as_str()) {
+                archive_account(state, &old).await?;
+            }
+        }
+    }
+
+    // A brokerage that no longer has anything gets an empty snapshot, which the
+    // complete declaration of both sources allows.
+    for stale in accounts_with_marker_prefix(state, &marker(CRV_ACCOUNT_PREFIX))? {
+        if stale
+            .meta
+            .as_deref()
+            .is_some_and(|meta| active.contains(meta))
+        {
+            continue;
+        }
+        save_source_snapshot(
+            state,
+            &stale.id,
+            &stale.currency,
+            crv_date,
+            Vec::new(),
+            Vec::new(),
+        )
+        .await?;
+    }
+    Ok(outcome)
+}
+
+/// The CB side: bank accounts, applications and cards as ledgers, plus the
+/// dividend and lending credits of the brokerages (which carry no balance).
+/// Returns (items, accounts, activities written).
+pub(super) async fn sync_cb_ledger(
+    state: &AppState,
+    snapshot: &Value,
+    today: &str,
+    brokerage_accounts: Option<&HashMap<String, String>>,
+) -> Result<(usize, usize, usize), String> {
+    let items = validate_cb_snapshot(snapshot)?;
+    let reference_date = snapshot
+        .get("snapshot_as_of")
+        .and_then(Value::as_str)
+        .map(str::to_string);
+    let accounts = parse_cb_accounts(items)?;
+    let categories = parse_categories(items);
+    let entries = parse_ledger_entries(items);
+
+    struct Ledger<'a> {
+        account: &'a CbAccount,
+        wealthfolio_id: String,
+        initial: Decimal,
+        initial_date: NaiveDate,
+        include_opening_day: bool,
+        newly_created: bool,
+    }
+    let mut ledgers: Vec<Ledger> = Vec::new();
+    for account in accounts.iter().filter(|account| !account.brokerage) {
+        // A missing balance is not a zero balance: the account is left alone.
+        let (Some(balance), Some(initial), Some(initial_date)) =
+            (account.balance, account.initial, account.initial_date)
+        else {
+            continue;
+        };
+        let date = reference_date
+            .clone()
+            .or_else(|| account.balance_as_of.clone())
+            .unwrap_or_else(|| today.to_string());
+        let through = NaiveDate::parse_from_str(&date, "%Y-%m-%d")
+            .map_err(|_| "Conta CB v4 inválida: data do saldo ausente.".to_string())?;
+        let movements = realized_movements(items, &account.source_id);
+        let Some(include_opening_day) =
+            opening_day_reading(initial, initial_date, &movements, through, balance)
+        else {
+            tracing::warn!(
+                "Patrimonio sync: the CB ledger of one account does not reproduce its balance; account left as it was"
+            );
+            continue;
+        };
+        let synced = ensure_source_account(
+            state,
+            &AccountSpec {
+                marker: marker(&account.source_id),
+                provider: CB_PROVIDER,
+                provider_account_id: &account.source_id,
+                name: ledger_account_name(account),
+                currency: &account.currency,
+                account_type: account.kind.account_type(),
+                group: Some(account.kind.group()),
+                tracking_mode: TrackingMode::Transactions,
+            },
+        )
+        .await?;
+        if synced.created {
+            if let Err(error) = state
+                .spending_settings_service
+                .auto_include_account(&synced.id)
+                .await
+            {
+                tracing::warn!("Patrimonio sync: could not include an account in Spending: {error}");
+            }
+        }
+        ledgers.push(Ledger {
+            account,
+            wealthfolio_id: synced.id,
+            initial,
+            initial_date,
+            include_opening_day,
+            newly_created: synced.created,
+        });
+    }
+    let _ = ledgers.iter().filter(|ledger| ledger.newly_created).count();
+
+    let by_source: HashMap<&str, &Ledger> = ledgers
+        .iter()
+        .map(|ledger| (ledger.account.source_id.as_str(), ledger))
+        .collect();
+    let through_of = |ledger: &Ledger| -> NaiveDate {
+        reference_date
+            .as_deref()
+            .or(ledger.account.balance_as_of.as_deref())
+            .and_then(|date| NaiveDate::parse_from_str(date, "%Y-%m-%d").ok())
+            .or_else(|| NaiveDate::parse_from_str(today, "%Y-%m-%d").ok())
+            .unwrap_or(ledger.initial_date)
+    };
+    let selected: Vec<&LedgerEntry> = entries
+        .iter()
+        .filter(|entry| {
+            by_source.get(entry.account.as_str()).is_some_and(|ledger| {
+                entry.date <= through_of(ledger)
+                    && if ledger.include_opening_day {
+                        entry.date >= ledger.initial_date
+                    } else {
+                        entry.date > ledger.initial_date
+                    }
+            })
+        })
+        .collect();
+    let paired = paired_transfer_groups(&selected);
+
+    let mut desired: Vec<Desired> = Vec::new();
+    let mut managed: BTreeSet<String> = BTreeSet::new();
+    for ledger in &ledgers {
+        managed.insert(ledger.wealthfolio_id.clone());
+        if let Some(opening) = opening_activity(
+            ledger.account,
+            &ledger.wealthfolio_id,
+            ledger.initial,
+            ledger.initial_date,
+        ) {
+            desired.push(opening);
+        }
+    }
+    for entry in &selected {
+        let ledger = by_source[entry.account.as_str()];
+        let name = categories
+            .get(&entry.category_id)
+            .map(|category| category.name.as_str())
+            .unwrap_or_default();
+        let group = if entry.transfer_like {
+            let id = entry
+                .transfer_id
+                .clone()
+                .unwrap_or_else(|| entry.key.clone());
+            let external = !paired.contains(&id);
+            Some((id, external))
+        } else {
+            None
+        };
+        desired.push(entry_activity(
+            entry,
+            ledger.account.kind,
+            &ledger.wealthfolio_id,
+            name,
+            group,
+        ));
+    }
+
+    // Brokerage income (dividend, JCP, share lending): activities that carry no
+    // balance, because those accounts stay in holdings mode.
+    if let Some(brokerages) = brokerage_accounts {
+        for account_id in brokerages.values() {
+            managed.insert(account_id.clone());
+        }
+        for entry in parse_income_entries(items) {
+            let Some(account_id) = brokerages.get(&entry.account_source_id) else {
+                continue;
+            };
+            if entry.kind == IncomeKind::Dividend && entry.symbol.is_none() {
+                continue;
+            }
+            let json = income_activity_json(&entry, account_id);
+            desired.push(Desired {
+                key: entry.key.clone(),
+                account_id: account_id.clone(),
+                activity_type: entry.kind.activity_type().to_string(),
+                amount: entry.amount,
+                currency: entry.currency.clone(),
+                date: entry.date,
+                group_id: None,
+                json,
+                category: None,
+            });
+        }
+    }
+
+    let (created, removed, failed) = reconcile_activities(state, &desired, &managed).await?;
+    if created > 0 || removed > 0 {
+        tracing::info!("Patrimonio sync: CB activities created={created} removed={removed}");
+    }
+    assign_categories(state, &desired, &managed).await;
+    if failed > 0 {
+        return Err(format!(
+            "{failed} atividades do CB não foram gravadas; a próxima execução tenta de novo."
+        ));
+    }
+    Ok((items.len(), ledgers.len(), created))
+}
+
+/// The CB coverage the importer needs before it applies or clears anything:
+/// the three collections declared complete and the declared counts matching.
+pub(super) fn validate_cb_snapshot(snapshot: &Value) -> Result<&Vec<Value>, String> {
+    let items = snapshot
+        .get("items")
+        .and_then(Value::as_array)
+        .ok_or_else(|| "Snapshot CB v4 inválido: lista de itens ausente.".to_string())?;
+    let coverage = snapshot.get("coverage");
+    for name in ["account", "cash_entry", "category"] {
+        let declared = coverage
+            .and_then(|coverage| coverage.get(name))
+            .and_then(|value| value.get("count"))
+            .and_then(Value::as_u64);
+        let found = items
+            .iter()
+            .filter(|item| item.get("resource").and_then(Value::as_str) == Some(name))
+            .count() as u64;
+        let state_ok = coverage
+            .and_then(|coverage| coverage.get(name))
+            .and_then(|value| value.get("state"))
+            .and_then(Value::as_str)
+            == Some("complete");
+        if !state_ok || declared != Some(found) {
+            return Err(format!(
+                "Snapshot CB v4 inválido: cobertura de {name} incompleta."
+            ));
+        }
+    }
+    Ok(items)
+}
