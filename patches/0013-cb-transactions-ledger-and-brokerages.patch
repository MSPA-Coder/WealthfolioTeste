@@ -0,0 +1,1602 @@
+//! Phase 3 of the CB/CRV import: what an "account" means in each system.
+//!
+//! * A CB bank account, savings application or credit card becomes a
+//!   Wealthfolio account tracked by TRANSACTIONS: the realized CB entries are
+//!   mirrored as activities, so the balance, the history and Spending come from
+//!   the ledger. An account is only switched after the ledger reproduces the
+//!   balance the CB publishes, to the cent.
+//! * A brokerage is one Wealthfolio account per (broker, currency) holding the
+//!   cash the CB publishes and the positions the CRV publishes in the same
+//!   snapshot. It stays in HOLDINGS mode: the CB settles stock trades by day
+//!   and nothing in it ties a settlement to a CRV trade.
+//!
+//! Everything here is read-only on the sources, idempotent, and only touches
+//! activities this importer wrote (source system and idempotency key).
+
+use super::*;
+use std::collections::HashMap;
+
+use wealthfolio_core::{activities::ActivityBulkMutationRequest, taxonomies::NewCategory};
+use wealthfolio_spending::activity_assignments::BulkCategoryAssignment;
+
+const SPENDING_TAXONOMY: &str = "spending_categories";
+const INCOME_TAXONOMY: &str = "income_sources";
+
+const GROUP_CHECKING: &str = "Contas correntes";
+const GROUP_SAVINGS: &str = "Aplicações";
+const GROUP_CARDS: &str = "Cartões";
+const GROUP_BROKERAGE: &str = "Corretoras";
+
+const BULK_CHUNK: usize = 150;
+
+const BROKERS: [(&str, &str); 5] = [
+    ("genial", "Genial"),
+    ("xp", "XP"),
+    ("avenue", "Avenue"),
+    ("nomad", "Nomad"),
+    ("revolut", "Revolut"),
+];
+/// Institution names the CB uses for a broker under another name.
+const BROKER_ALIASES: [(&str, &str); 1] = [("scpxpinvestimentos", "xp")];
+
+const CATEGORY_COLORS: [&str; 8] = [
+    "#8abceb", "#f2b36d", "#7fc8a9", "#d98fb0", "#b3a2e0", "#e0c85f", "#7fb8c9", "#c98f7f",
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum CbKind {
+    Checking,
+    Savings,
+    Card,
+}
+
+impl CbKind {
+    fn group(self) -> &'static str {
+        match self {
+            CbKind::Checking => GROUP_CHECKING,
+            CbKind::Savings => GROUP_SAVINGS,
+            CbKind::Card => GROUP_CARDS,
+        }
+    }
+
+    fn account_type(self) -> &'static str {
+        match self {
+            CbKind::Card => account_types::CREDIT_CARD,
+            _ => account_types::CASH,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct CbAccount {
+    pub source_id: String,
+    pub name: String,
+    pub currency: String,
+    pub kind: CbKind,
+    pub owner: String,
+    pub institution: String,
+    pub brokerage: bool,
+    pub initial: Option<Decimal>,
+    pub initial_date: Option<NaiveDate>,
+    pub balance: Option<Decimal>,
+    pub balance_as_of: Option<String>,
+}
+
+pub(super) fn parse_cb_accounts(items: &[Value]) -> Result<Vec<CbAccount>, String> {
+    let mut accounts = Vec::new();
+    for item in items {
+        if item.get("resource").and_then(Value::as_str) != Some("account") {
+            continue;
+        }
+        let payload = item
+            .get("payload")
+            .ok_or_else(|| "Conta CB v4 inválida: dados ausentes.".to_string())?;
+        let text = |key: &str| {
+            payload
+                .get(key)
+                .and_then(Value::as_str)
+                .unwrap_or_default()
+                .trim()
+                .to_string()
+        };
+        let kind = match payload.get("account_type").and_then(Value::as_str) {
+            Some("cartao_credito") => CbKind::Card,
+            Some("aplicacao") => CbKind::Savings,
+            _ => CbKind::Checking,
+        };
+        accounts.push(CbAccount {
+            source_id: required_string(payload, "source_id", "ID da conta CB")?.to_string(),
+            name: required_string(payload, "name", "nome da conta CB")?.to_string(),
+            currency: required_string(payload, "currency", "moeda da conta CB")?.to_string(),
+            kind,
+            owner: text("owner_name"),
+            institution: text("institution_name"),
+            brokerage: payload.get("institution_type").and_then(Value::as_str)
+                == Some("Corretora"),
+            initial: payload
+                .get("initial_balance")
+                .and_then(Value::as_str)
+                .and_then(|value| value.parse::<Decimal>().ok()),
+            initial_date: payload
+                .get("initial_balance_date")
+                .and_then(Value::as_str)
+                .and_then(|value| NaiveDate::parse_from_str(value, "%Y-%m-%d").ok()),
+            balance: payload
+                .get("balance")
+                .and_then(Value::as_str)
+                .and_then(|value| value.parse::<Decimal>().ok()),
+            balance_as_of: payload
+                .get("balance_as_of")
+                .and_then(Value::as_str)
+                .map(str::to_string),
+        });
+    }
+    Ok(accounts)
+}
+
+/// `Titular · Instituição · Conta`: "Conta 01" alone exists three times.
+pub(super) fn ledger_account_name(account: &CbAccount) -> String {
+    [
+        account.owner.as_str(),
+        account.institution.as_str(),
+        account.name.as_str(),
+    ]
+    .iter()
+    .filter(|part| !part.trim().is_empty())
+    .copied()
+    .collect::<Vec<_>>()
+    .join(" · ")
+}
+
+fn compact(text: &str) -> String {
+    fold_text(text)
+        .chars()
+        .filter(|c| c.is_ascii_alphanumeric())
+        .collect()
+}
+
+/// The broker an institution or CRV account name stands for.
+pub(super) fn broker_key(raw: &str) -> String {
+    let compact = compact(raw);
+    for (alias, key) in BROKER_ALIASES {
+        if compact == alias {
+            return key.to_string();
+        }
+    }
+    compact
+}
+
+fn broker_display(key: &str, fallback: &str) -> String {
+    BROKERS
+        .iter()
+        .find(|(known, _)| *known == key)
+        .map(|(_, title)| title.to_string())
+        .unwrap_or_else(|| fallback.trim().to_string())
+}
+
+fn short_hash(text: &str) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(text.as_bytes());
+    format!("{:x}", hasher.finalize())[..12].to_string()
+}
+
+// ---------------------------------------------------------------------------
+// CB entries
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub(super) struct CbCategory {
+    pub name: String,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct LedgerEntry {
+    pub key: String,
+    pub account: String,
+    pub date: NaiveDate,
+    pub amount: Decimal,
+    pub currency: String,
+    pub income: bool,
+    /// Transfers and investment moves: anything the CB does not call "gerencial".
+    pub transfer_like: bool,
+    pub category_id: String,
+    pub transfer_id: Option<String>,
+    pub description: String,
+}
+
+pub(super) fn parse_categories(items: &[Value]) -> HashMap<String, CbCategory> {
+    items
+        .iter()
+        .filter(|item| item.get("resource").and_then(Value::as_str) == Some("category"))
+        .filter_map(|item| item.get("payload"))
+        .filter_map(|payload| {
+            Some((
+                payload.get("source_id")?.as_str()?.to_string(),
+                CbCategory {
+                    name: payload.get("name")?.as_str()?.to_string(),
+                },
+            ))
+        })
+        .collect()
+}
+
+/// Realized entries only: planned and overdue ones have not moved money yet.
+pub(super) fn parse_ledger_entries(items: &[Value]) -> Vec<LedgerEntry> {
+    items
+        .iter()
+        .filter(|item| item.get("resource").and_then(Value::as_str) == Some("cash_entry"))
+        .filter_map(|item| {
+            let key = item.get("source_id").and_then(Value::as_str)?;
+            let payload = item.get("payload")?;
+            if payload.get("status").and_then(Value::as_str) != Some("realizado") {
+                return None;
+            }
+            let income = match payload.get("entry_type").and_then(Value::as_str)? {
+                "receita" => true,
+                "despesa" => false,
+                _ => return None,
+            };
+            let date = NaiveDate::parse_from_str(
+                payload.get("realized_date")?.as_str()?,
+                "%Y-%m-%d",
+            )
+            .ok()?;
+            let amount = payload
+                .get("realized_amount")?
+                .as_str()?
+                .parse::<Decimal>()
+                .ok()?;
+            Some(LedgerEntry {
+                key: key.to_string(),
+                account: payload.get("account_id")?.as_str()?.to_string(),
+                date,
+                amount,
+                currency: payload
+                    .get("currency")
+                    .and_then(Value::as_str)
+                    .unwrap_or("BRL")
+                    .to_string(),
+                income,
+                transfer_like: payload.get("category_kind").and_then(Value::as_str)
+                    != Some("gerencial"),
+                category_id: payload
+                    .get("category_id")
+                    .and_then(Value::as_str)
+                    .unwrap_or_default()
+                    .to_string(),
+                transfer_id: payload
+                    .get("transfer_id")
+                    .and_then(Value::as_str)
+                    .map(str::to_string),
+                description: payload
+                    .get("description")
+                    .and_then(Value::as_str)
+                    .unwrap_or_default()
+                    .to_string(),
+            })
+        })
+        .collect()
+}
+
+/// Which reading of the opening day reproduces the balance the CB publishes:
+/// `Some(false)` when entries dated on the opening day are already in the
+/// opening balance, `Some(true)` when they come on top of it, `None` when
+/// neither does (the ledger is then not trusted).
+pub(super) fn opening_day_reading(
+    initial: Decimal,
+    initial_date: NaiveDate,
+    movements: &[(NaiveDate, Decimal)],
+    through: NaiveDate,
+    expected_final: Decimal,
+) -> Option<bool> {
+    [false, true].into_iter().find(|include_opening_day| {
+        let total: Decimal = movements
+            .iter()
+            .filter(|(date, _)| {
+                *date <= through
+                    && if *include_opening_day {
+                        *date >= initial_date
+                    } else {
+                        *date > initial_date
+                    }
+            })
+            .map(|(_, amount)| *amount)
+            .sum();
+        initial + total == expected_final
+    })
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct Desired {
+    pub key: String,
+    pub account_id: String,
+    pub activity_type: String,
+    pub amount: Decimal,
+    pub currency: String,
+    pub date: NaiveDate,
+    pub group_id: Option<String>,
+    pub json: Value,
+    /// Taxonomy, CB category id and name to label this activity with.
+    pub category: Option<(&'static str, String, String)>,
+}
+
+fn activity_date(date: NaiveDate) -> String {
+    format!("{date}T12:00:00.000Z")
+}
+
+fn base_json(
+    key: &str,
+    account_id: &str,
+    activity_type: &str,
+    date: NaiveDate,
+    currency: &str,
+    amount: Decimal,
+    notes: String,
+) -> Value {
+    serde_json::json!({
+        "accountId": account_id,
+        "activityType": activity_type,
+        "activityDate": activity_date(date),
+        "currency": currency,
+        "amount": amount.to_string(),
+        "status": "POSTED",
+        "notes": notes,
+        "sourceSystem": CB_SOURCE_SYSTEM,
+        "sourceRecordId": key,
+        "idempotencyKey": key,
+    })
+}
+
+/// The balance a CB account opens with, as one neutral cash movement dated on
+/// the opening day. CREDIT without a subtype adds cash and is neither income
+/// nor spending; a negative opening (an owed card) is a charge dated the same day.
+pub(super) fn opening_activity(
+    account: &CbAccount,
+    account_id: &str,
+    initial: Decimal,
+    initial_date: NaiveDate,
+) -> Option<Desired> {
+    if initial.is_zero() {
+        return None;
+    }
+    let key = format!("controle-bancario:opening:{}", account.source_id);
+    let (activity_type, amount) = if initial > Decimal::ZERO {
+        ("CREDIT", initial)
+    } else {
+        ("WITHDRAWAL", -initial)
+    };
+    let json = base_json(
+        &key,
+        account_id,
+        activity_type,
+        initial_date,
+        &account.currency,
+        amount,
+        "CB: saldo inicial".to_string(),
+    );
+    Some(Desired {
+        key,
+        account_id: account_id.to_string(),
+        activity_type: activity_type.to_string(),
+        amount,
+        currency: account.currency.clone(),
+        date: initial_date,
+        group_id: None,
+        json,
+        category: None,
+    })
+}
+
+/// One CB entry as one activity of the ledger. `group` is the transfer group
+/// and whether the other leg lives outside the ledger.
+pub(super) fn entry_activity(
+    entry: &LedgerEntry,
+    kind: CbKind,
+    account_id: &str,
+    category_name: &str,
+    group: Option<(String, bool)>,
+) -> Desired {
+    let card = kind == CbKind::Card;
+    let mut subtype: Option<&str> = None;
+    let mut asset: Option<Value> = None;
+    let mut taxonomy: Option<&'static str> = None;
+    let activity_type = if entry.transfer_like {
+        if entry.income {
+            "TRANSFER_IN"
+        } else {
+            "TRANSFER_OUT"
+        }
+    } else if !entry.income {
+        taxonomy = Some(SPENDING_TAXONOMY);
+        "WITHDRAWAL"
+    } else if card {
+        subtype = Some("REFUND");
+        taxonomy = Some(SPENDING_TAXONOMY);
+        "CREDIT"
+    } else if is_income_category(category_name) {
+        // Dividends, JCP and share lending keep their income type; a dividend
+        // with no ticker still moved cash, so it is a plain deposit.
+        let kind = income_kind(&entry.description);
+        let symbol = ticker_from_description(&entry.description);
+        match (kind, symbol) {
+            (IncomeKind::Dividend, None) => {
+                taxonomy = Some(INCOME_TAXONOMY);
+                "DEPOSIT"
+            }
+            (kind, symbol) => {
+                if let Some(symbol) = symbol {
+                    asset = Some(serde_json::json!({ "symbol": symbol, "exchangeMic": B3_MIC }));
+                }
+                if kind == IncomeKind::Lending {
+                    taxonomy = Some(INCOME_TAXONOMY);
+                }
+                kind.activity_type()
+            }
+        }
+    } else {
+        taxonomy = Some(INCOME_TAXONOMY);
+        "DEPOSIT"
+    };
+
+    let mut json = base_json(
+        &entry.key,
+        account_id,
+        activity_type,
+        entry.date,
+        &entry.currency,
+        entry.amount,
+        format!("CB: {}", entry.description),
+    );
+    if let Some(subtype) = subtype {
+        json["subtype"] = Value::String(subtype.to_string());
+    }
+    if let Some(asset) = asset {
+        json["asset"] = asset;
+    }
+    let group_id = group.as_ref().map(|(id, _)| id.clone());
+    if let Some((id, external)) = &group {
+        json["sourceGroupId"] = Value::String(id.clone());
+        if *external {
+            json["metadata"] = Value::String(
+                serde_json::json!({ "flow": { "is_external": true } }).to_string(),
+            );
+        }
+    }
+    Desired {
+        key: entry.key.clone(),
+        account_id: account_id.to_string(),
+        activity_type: activity_type.to_string(),
+        amount: entry.amount,
+        currency: entry.currency.clone(),
+        date: entry.date,
+        group_id,
+        json,
+        category: taxonomy
+            .filter(|_| !entry.category_id.is_empty())
+            .map(|taxonomy| (taxonomy, entry.category_id.clone(), category_name.to_string())),
+    }
+}
+
+/// Transfer groups that are a real pair inside the ledger: two legs on two
+/// accounts, one in and one out, same currency and same amount. Anything else
+/// is a single leg whose other side is outside the ledger.
+pub(super) fn paired_transfer_groups(entries: &[&LedgerEntry]) -> BTreeSet<String> {
+    let mut by_group: BTreeMap<&str, Vec<&LedgerEntry>> = BTreeMap::new();
+    for entry in entries {
+        if entry.transfer_like {
+            if let Some(id) = entry.transfer_id.as_deref() {
+                by_group.entry(id).or_default().push(entry);
+            }
+        }
+    }
+    by_group
+        .into_iter()
+        .filter(|(_, legs)| {
+            legs.len() == 2
+                && legs[0].account != legs[1].account
+                && legs[0].income != legs[1].income
+                && legs[0].currency == legs[1].currency
+                && legs[0].amount == legs[1].amount
+        })
+        .map(|(id, _)| id.to_string())
+        .collect()
+}
+
+fn desired_matches(activity: &Activity, desired: &Desired) -> bool {
+    activity.account_id == desired.account_id
+        && activity.activity_type == desired.activity_type
+        && activity.amount == Some(desired.amount)
+        && activity.currency == desired.currency
+        && activity.activity_date.date_naive() == desired.date
+        && activity.source_group_id == desired.group_id
+}
+
+fn cb_activities(state: &AppState, managed: &BTreeSet<String>) -> Result<Vec<Activity>, String> {
+    let all = state
+        .activity_service
+        .get_activities_including_archived_accounts()
+        .or_else(|_| {
+            let ids: Vec<String> = managed.iter().cloned().collect();
+            state.activity_service.get_activities_by_account_ids(&ids)
+        })
+        .map_err(|_| "Não foi possível ler as atividades existentes.".to_string())?;
+    Ok(all
+        .into_iter()
+        .filter(|activity| activity.source_system.as_deref() == Some(CB_SOURCE_SYSTEM))
+        .collect())
+}
+
+/// Brings the CB activities to exactly `desired` on the managed accounts. An
+/// activity that changed, or that sits on another account than it should (an
+/// account that was archived and replaced), is deleted and recreated; one that
+/// the CB no longer publishes is deleted. Returns (created, removed, failed).
+async fn reconcile_activities(
+    state: &AppState,
+    desired: &[Desired],
+    managed: &BTreeSet<String>,
+) -> Result<(usize, usize, usize), String> {
+    let by_key: HashMap<&str, &Desired> =
+        desired.iter().map(|item| (item.key.as_str(), item)).collect();
+    let mut failed = 0;
+
+    let mut stale: Vec<String> = Vec::new();
+    for activity in cb_activities(state, managed)? {
+        let key = activity.idempotency_key.as_deref();
+        let keep = key
+            .and_then(|key| by_key.get(key))
+            .is_some_and(|item| desired_matches(&activity, item));
+        let delete = !keep
+            && (key.is_some_and(|key| by_key.contains_key(key))
+                || managed.contains(&activity.account_id));
+        if delete {
+            stale.push(activity.id);
+        }
+    }
+    let removed = stale.len();
+    for chunk in stale.chunks(BULK_CHUNK) {
+        let result = state
+            .activity_service
+            .bulk_mutate_activities(ActivityBulkMutationRequest {
+                creates: Vec::new(),
+                updates: Vec::new(),
+                delete_ids: chunk.to_vec(),
+            })
+            .await
+            .map_err(|_| "Não foi possível remover atividades desatualizadas.".to_string())?;
+        failed += result.errors.len();
+    }
+
+    // Deleting one leg of a pair can take the other with it, so what exists is
+    // read again before deciding what to create.
+    let present: BTreeSet<String> = cb_activities(state, managed)?
+        .into_iter()
+        .filter_map(|activity| activity.idempotency_key)
+        .collect();
+    let mut creates: Vec<NewActivity> = Vec::new();
+    for item in desired {
+        if present.contains(&item.key) {
+            continue;
+        }
+        match serde_json::from_value::<NewActivity>(item.json.clone()) {
+            Ok(new_activity) => creates.push(new_activity),
+            Err(_) => failed += 1,
+        }
+    }
+    let created_total = creates.len();
+    let mut created = 0;
+    while !creates.is_empty() {
+        let rest = creates.split_off(creates.len().min(BULK_CHUNK));
+        let batch = std::mem::replace(&mut creates, rest);
+        let attempted = batch.len();
+        let result = state
+            .activity_service
+            .bulk_mutate_activities(ActivityBulkMutationRequest {
+                creates: batch,
+                updates: Vec::new(),
+                delete_ids: Vec::new(),
+            })
+            .await
+            .map_err(|_| "Não foi possível gravar as atividades do CB.".to_string())?;
+        failed += result.errors.len();
+        created += attempted.saturating_sub(result.errors.len());
+    }
+    debug_assert!(created <= created_total);
+    Ok((created, removed, failed))
+}
