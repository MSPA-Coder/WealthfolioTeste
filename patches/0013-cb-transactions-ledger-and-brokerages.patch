+    /// Signed cash effect, the way the holdings engine reads the type.
+    fn cash_effect(desired: &Desired) -> Decimal {
+        match desired.activity_type.as_str() {
+            "CREDIT" | "DEPOSIT" | "DIVIDEND" | "INTEREST" | "TRANSFER_IN" => desired.amount,
+            "WITHDRAWAL" | "TRANSFER_OUT" => -desired.amount,
+            other => panic!("unexpected type {other}"),
+        }
+    }
