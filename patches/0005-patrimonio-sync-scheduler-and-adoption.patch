+        .map_err(|_| ApiError::Internal("Falha ao salvar checkpoint de sincronização.".into()))?;
+    if let Err(error) = state
+        .addon_service
+        .set_addon_storage_item(
+            ADDON_ID,
+            &format!("{STATUS_STORAGE_PREFIX}{}", source.id),
+            &serialized,
+        )
+        .await
+    {
+        tracing::debug!("Estado da sincronização patrimonial não copiado para o add-on: {error}");
+    }
+    Ok(())
+}
+
+/// `None` keeps the worker off: unset, `0`, or anything that is not a number.
+fn parse_interval(raw: Option<&str>) -> Option<Duration> {
+    let seconds = raw?.trim().parse::<u64>().ok()?;
+    (seconds > 0).then(|| Duration::from_secs(seconds.max(MIN_INTERVAL_SECS)))
+}
+
+/// Whether the periodic import is switched on. It decides if profiles are opened
+/// at startup, because the worker lives in the profile's runtime.
+pub(crate) fn scheduler_enabled() -> bool {
+    parse_interval(std::env::var(INTERVAL_ENV).ok().as_deref()).is_some()
+}
+
+/// Starts the periodic import. It never needs a browser: the daily snapshot
+/// used to depend on someone having the add-on open.
+pub(crate) fn start_scheduler(state: Arc<AppState>) {
+    let Some(every) = parse_interval(std::env::var(INTERVAL_ENV).ok().as_deref()) else {
+        tracing::info!("Patrimonio sync scheduler off: {INTERVAL_ENV} is not set");
+        return;
+    };
+    tracing::info!(
+        "Patrimonio sync scheduler started (every {}s)",
+        every.as_secs()
+    );
+    let runtime = state.clone();
+    let worker = tokio::spawn(async move {
+        tokio::time::sleep(Duration::from_secs(INITIAL_DELAY_SECS)).await;
+        let mut ticker = tokio::time::interval(every);
+        ticker.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+        loop {
+            ticker.tick().await;
+            match run_sync(&runtime, false).await {
+                None => tracing::debug!("Patrimonio sync skipped: a run is already in progress"),
+                Some(Err(_)) => tracing::warn!("Patrimonio sync could not save its status"),
+                Some(Ok(statuses)) => {
+                    for status in statuses.iter().filter(|status| status.state == "failed") {
+                        tracing::warn!("Patrimonio sync failed for source {}", status.source);
+                    }
+                }
+            }
+        }
+    });
+    state.workers.lock().unwrap().push(worker);
 }
 
