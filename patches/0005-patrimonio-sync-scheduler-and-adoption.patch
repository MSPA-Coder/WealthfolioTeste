+
+/// `Some(false)` when the feed has nothing after the checkpoint. `None` when the
+/// source has no feed (404), which means "cannot tell": import in full.
+async fn changed_since(
+    source: Source,
+    authorization: Option<&str>,
+    checkpoint: Option<&str>,
+) -> Result<Option<bool>, String> {
+    let query = match checkpoint {
+        Some(value) => format!("?after={}&limit=1", percent_encode(value)),
+        None => "?limit=1".to_string(),
+    };
+    let (status, body) = request(
+        source,
+        format!("{}/changes{}", source.base_url, query),
+        authorization,
+    )
+    .await?;
+    if status == 404 {
+        return Ok(None);
+    }
+    if !(200..300).contains(&status) {
+        return Err(format!("Fonte {} retornou HTTP {}.", source.id, status));
+    }
+    let body: Value = serde_json::from_str(&body)
+        .map_err(|_| format!("Fonte {} retornou JSON inválido.", source.id))?;
+    let has_items = body
+        .get("items")
+        .and_then(Value::as_array)
+        .is_some_and(|items| !items.is_empty());
+    Ok(Some(has_items))
+}
+
+fn percent_encode(value: &str) -> String {
+    let mut encoded = String::with_capacity(value.len());
+    for byte in value.bytes() {
+        if byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'.' | b'_' | b'~') {
+            encoded.push(byte as char);
+        } else {
+            encoded.push_str(&format!("%{byte:02X}"));
+        }
+    }
+    encoded
+}
+
+fn marker(source_id: &str) -> String {
+    format!("{MARKER_PREFIX}:{source_id}")
