+/// Whether the change feed can stand in for a full snapshot this time.
+fn needs_change_check(previous: &SourceStatus, today: &str, force: bool) -> bool {
+    !force
+        && previous.state == "ready"
+        && previous.high_watermark.is_some()
+        && previous.applied_on.as_deref() == Some(today)
