+/// Whether the account already has a snapshot with positions before `date`.
+/// The CB cash history is written without positions, so rewriting it over such
+/// a history would erase them; the history that exists is kept as it is.
+fn has_position_history(state: &AppState, account_id: &str, date: NaiveDate) -> bool {
+    let before = date.pred_opt().unwrap_or(date);
+    state
+        .snapshot_service
+        .get_snapshot_metadata(account_id, None, Some(before))
+        .map(|snapshots| snapshots.iter().any(|snapshot| snapshot.position_count > 0))
+        .unwrap_or(false)
+}
