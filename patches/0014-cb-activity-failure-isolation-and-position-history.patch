+async fn bulk_create(
+    state: &AppState,
+    batch: Vec<NewActivity>,
+) -> Result<wealthfolio_core::activities::ActivityBulkMutationResult, String> {
+    state
+        .activity_service
+        .bulk_mutate_activities(ActivityBulkMutationRequest {
+            creates: batch,
+            updates: Vec::new(),
+            delete_ids: Vec::new(),
+        })
+        .await
+        .map_err(|_| "Não foi possível gravar as atividades do CB.".to_string())
+}
+
+/// One bulk call writes nothing at all when any row of it is invalid, so a
+/// chunk that comes back with errors is retried row by row: the valid rows are
+/// saved, and only the invalid ones are counted and named in the log.
+/// Returns (written, rejected).
+async fn create_isolating(
+    state: &AppState,
+    batch: Vec<NewActivity>,
+) -> Result<(usize, usize), String> {
+    let attempted = batch.len();
+    let result = bulk_create(state, batch.clone()).await?;
+    if result.errors.is_empty() {
+        return Ok((attempted, 0));
+    }
+    let mut written = 0;
+    let mut rejected = 0;
+    for activity in batch {
+        let key = activity.idempotency_key.clone().unwrap_or_default();
+        let single = bulk_create(state, vec![activity]).await?;
+        if single.errors.is_empty() {
+            written += 1;
+        } else {
+            rejected += 1;
+            for error in &single.errors {
+                tracing::warn!(
+                    "Patrimonio sync: activity {key} was not written: {}",
+                    error.message
+                );
+            }
+        }
+    }
+    Ok((written, rejected))
+}
