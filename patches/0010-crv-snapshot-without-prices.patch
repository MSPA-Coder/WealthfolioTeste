+/// The CRV snapshot carries the whole price history, which grows every day and
+/// passed the 2 MiB addon-network response limit on 2026-10-16. The importer
+/// only reads accounts and holdings, so it asks the CRV to leave the history out.
+fn snapshot_url(source: Source) -> String {
+    if source.id == "crv" {
+        format!("{}/snapshot?include_prices=false", source.base_url)
+    } else {
+        format!("{}/snapshot", source.base_url)
+    }
+}
