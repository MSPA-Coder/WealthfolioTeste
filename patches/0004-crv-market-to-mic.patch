+/// O CRV nomeia o mercado ("B3", "NYSE", "NASDAQ"); o Wealthfolio espera o MIC
+/// (ISO 10383). Sem o MIC, o resolvedor de cotações não acha o sufixo do Yahoo
+/// (`.SA` para a B3) e pede o ticker puro, que o Yahoo recusa com 404.
+fn market_to_mic(market: &str) -> &str {
+    match market {
+        "B3" => "BVMF",
+        "NYSE" => "XNYS",
+        "NASDAQ" => "XNAS",
+        other => other,
+    }
+}
