+/// Realized cash movements of one CB account as (date, signed amount): income
+/// adds and expense subtracts. Planned or overdue entries are not movements yet.
+fn realized_movements(items: &[Value], account_source_id: &str) -> Vec<(NaiveDate, Decimal)> {
+    items
+        .iter()
+        .filter(|item| item.get("resource").and_then(Value::as_str) == Some("cash_entry"))
+        .filter_map(|item| item.get("payload"))
+        .filter(|payload| {
+            payload.get("account_id").and_then(Value::as_str) == Some(account_source_id)
+                && payload.get("status").and_then(Value::as_str) == Some("realizado")
+        })
+        .filter_map(|payload| {
+            let date = payload
+                .get("realized_date")
+                .and_then(Value::as_str)
+                .and_then(|date| NaiveDate::parse_from_str(date, "%Y-%m-%d").ok())?;
+            let amount = payload
+                .get("realized_amount")
+                .and_then(Value::as_str)
+                .and_then(|amount| amount.parse::<Decimal>().ok())?;
+            match payload.get("entry_type").and_then(Value::as_str) {
+                Some("receita") => Some((date, amount)),
+                Some("despesa") => Some((date, -amount)),
+                _ => None,
+            }
+        })
+        .collect()
+}
+
+/// Running cash balance on every day the balance changed, from the opening
+/// balance to `through`. Returns None unless the result ends exactly at
+/// `expected_final`: a history that does not reproduce the balance the source
+/// publishes is not written. Whether movements dated on the opening day are
+/// already inside the opening balance is not part of the contract, so both
+/// readings are tried and the one that reproduces the balance wins.
+fn balance_history(
+    initial: Decimal,
+    initial_date: NaiveDate,
+    movements: &[(NaiveDate, Decimal)],
+    through: NaiveDate,
+    expected_final: Decimal,
+) -> Option<Vec<(NaiveDate, Decimal)>> {
+    for include_opening_day in [false, true] {
+        let mut by_day: BTreeMap<NaiveDate, Decimal> = BTreeMap::new();
+        for (date, amount) in movements {
+            let counts = *date <= through
+                && if include_opening_day {
+                    *date >= initial_date
+                } else {
+                    *date > initial_date
+                };
+            if counts {
+                *by_day.entry(*date).or_insert(Decimal::ZERO) += *amount;
+            }
+        }
+        let mut balance = initial;
+        let mut series = vec![(initial_date, balance)];
+        for (date, delta) in by_day {
+            balance += delta;
+            if date == initial_date {
+                series[0] = (date, balance);
+            } else {
+                series.push((date, balance));
+            }
+        }
+        if balance == expected_final {
+            return Some(series);
+        }
+    }
+    None
+}
+
+fn history_digest(series: &[(NaiveDate, Decimal)]) -> String {
+    let mut hasher = Sha256::new();
+    for (date, balance) in series {
+        hasher.update(format!("{date}={balance};"));
+    }
+    format!("{:x}", hasher.finalize())
+}
+
+fn history_digest_key(source_id: &str) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(source_id.as_bytes());
+    format!("{:x}", hasher.finalize())[..16].to_string()
+}
+
+/// Writes the daily balance history of one CB account. A digest of the series
+/// is kept per account, so an import with no change in the past writes nothing.
+async fn backfill_cb_history(
+    state: &AppState,
+    account_id: &str,
+    currency: &str,
+    source_id: &str,
+    series: &[(NaiveDate, Decimal)],
+) -> Result<usize, String> {
+    let digest = history_digest(series);
+    let key = format!("{CB_HISTORY_KEY_PREFIX}{}", history_digest_key(source_id));
+    let stored = state.settings_service.get_setting_value(&key).ok().flatten();
+    if stored.as_deref() == Some(digest.as_str()) {
+        return Ok(0);
+    }
+    for (date, balance) in series {
+        save_source_snapshot(
+            state,
+            account_id,
+            currency,
+            *date,
+            Vec::new(),
+            vec![CashBalanceInput {
+                currency: currency.to_string(),
+                amount: *balance,
+            }],
+        )
+        .await?;
+    }
+    state
+        .settings_service
+        .set_setting_value(&key, &digest)
+        .await
+        .map_err(|_| "Não foi possível salvar o controle do histórico do CB.".to_string())?;
+    Ok(series.len())
+}
