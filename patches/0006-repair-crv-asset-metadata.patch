+/// Builds a holding without pinning it to a synthetic source id.
+///
+/// `ManualSnapshotService` resolves the canonical `(symbol, MIC, currency)` key
+/// before it creates an asset. Supplying the old deterministic `crv-asset-*`
+/// id made that service return legacy, metadata-free assets unchanged, so the
+/// holdings and valuation readers later discarded their positions. Leaving the
+/// id empty repairs those records on the next snapshot and keeps later imports
+/// on the resolved asset by instrument key.
+fn crv_holding_input(
+    symbol: &str,
+    exchange_mic: &str,
+    currency: &str,
+    quantity: Decimal,
+    average_cost: Decimal,
+) -> ManualHoldingInput {
+    ManualHoldingInput {
+        asset_id: None,
+        symbol: symbol.to_string(),
+        exchange_mic: Some(exchange_mic.to_string()),
+        quantity,
+        currency: currency.to_string(),
+        average_cost,
+        name: None,
+        data_source: None,
+        asset_kind: None,
+        quote_ccy: Some(currency.to_string()),
+        instrument_type: Some("EQUITY".into()),
+        provider_id: None,
+        provider_symbol: None,
+    }
+}
