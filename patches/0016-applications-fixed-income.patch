+    #[test]
+    fn the_marker_is_read_from_plain_text_and_from_json() {
+        let plain = marker("controle-bancario:account:1");
+        assert_eq!(account_marker(Some(&plain)), Some(plain.clone()));
+        let json = format!(r#"{{"controlePatrimonial":"{plain}","allocation":{{"cashCategoryId":"FIXED_INCOME"}}}}"#);
