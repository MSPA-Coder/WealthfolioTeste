+/// The importer marker of an account, whether `meta` holds it as plain text (how
+/// the accounts were first created) or inside a JSON object, which is what the
+/// account screen writes as soon as an allocation class is chosen.
+fn account_marker(meta: Option<&str>) -> Option<String> {
+    let meta = meta?.trim();
+    if meta.starts_with(MARKER_PREFIX) {
+        return Some(meta.to_string());
+    }
+    let parsed: Value = serde_json::from_str(meta).ok()?;
+    parsed.get(MARKER_PREFIX)?.as_str().map(str::to_string)
+}
+
+/// The allocation class chosen for the account's cash, if any.
+fn cash_category(meta: Option<&str>) -> Option<String> {
+    let parsed: Value = serde_json::from_str(meta?.trim()).ok()?;
+    parsed
+        .get("allocation")?
+        .get("cashCategoryId")?
+        .as_str()
+        .filter(|category| !category.is_empty())
+        .map(str::to_string)
+}
+
+/// `meta` for an imported account: the plain marker, or a JSON object with the
+/// marker and the allocation class when the account has one. The other keys of
+/// a JSON `meta` stay as they are, and a class already chosen is not replaced.
+fn account_meta(existing: Option<&str>, spec: &AccountSpec<'_>) -> String {
+    let mut object = existing
+        .and_then(|meta| serde_json::from_str::<Value>(meta.trim()).ok())
+        .and_then(|value| match value {
+            Value::Object(map) => Some(map),
+            _ => None,
+        })
+        .unwrap_or_default();
+    if spec.cash_category.is_none() && object.is_empty() {
+        return spec.marker.clone();
+    }
+    object.insert(MARKER_PREFIX.to_string(), Value::String(spec.marker.clone()));
+    if let Some(category) = spec.cash_category {
+        let allocation = object
+            .entry("allocation".to_string())
+            .or_insert_with(|| serde_json::json!({}));
+        if let Some(map) = allocation.as_object_mut() {
+            map.entry("cashCategoryId".to_string())
+                .or_insert_with(|| Value::String(category.to_string()));
+        }
+    }
+    Value::Object(object).to_string()
+}
