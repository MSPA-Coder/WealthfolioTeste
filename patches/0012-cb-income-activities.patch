+const CB_SOURCE_SYSTEM: &str = "CONTROLE_BANCARIO";
+const B3_MIC: &str = "BVMF";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum IncomeKind {
+    Dividend,
+    Lending,
+}
+
+impl IncomeKind {
+    fn activity_type(self) -> &'static str {
+        match self {
+            IncomeKind::Dividend => "DIVIDEND",
+            IncomeKind::Lending => "INTEREST",
+        }
+    }
+}
+
+/// A credit that the CB classifies as dividend, JCP or share-lending income.
+#[derive(Clone, Debug, PartialEq)]
+struct IncomeEntry {
+    key: String,
+    account_source_id: String,
+    date: NaiveDate,
+    amount: Decimal,
+    currency: String,
+    kind: IncomeKind,
+    symbol: Option<String>,
+    description: String,
+}
+
+fn fold_text(text: &str) -> String {
+    text.chars()
+        .map(|c| match c {
+            'á' | 'à' | 'â' | 'ã' | 'ä' | 'Á' | 'À' | 'Â' | 'Ã' => 'a',
+            'é' | 'è' | 'ê' | 'É' | 'Ê' => 'e',
+            'í' | 'î' | 'Í' => 'i',
+            'ó' | 'ô' | 'õ' | 'Ó' | 'Ô' | 'Õ' => 'o',
+            'ú' | 'û' | 'Ú' => 'u',
+            'ç' | 'Ç' => 'c',
+            other => other.to_ascii_lowercase(),
+        })
+        .collect()
+}
+
+fn is_income_category(name: &str) -> bool {
+    let folded = fold_text(name);
+    folded.contains("dividend") || folded.contains("jcp") || folded.contains("provento")
+}
+
+fn income_kind(description: &str) -> IncomeKind {
+    let folded = fold_text(description);
+    if folded.contains("remuneracao") || folded.contains("emprestimo") || folded.contains("aluguel")
+    {
+        IncomeKind::Lending
+    } else {
+        IncomeKind::Dividend
+    }
+}
+
+/// The ticker named in a bank description: either written out (`EALT4`) or
+/// derived from the ISIN-like code the broker prints (`Brraizacnpr6` is the
+/// preferred share of RAIZ, so RAIZ4). Funds and other classes return None.
+fn ticker_from_description(description: &str) -> Option<String> {
+    for token in description.split_whitespace() {
+        let chars: Vec<char> = token.chars().collect();
+        if (5..=6).contains(&chars.len())
+            && chars[..4].iter().all(|c| c.is_ascii_uppercase())
+            && chars[4..].iter().all(|c| c.is_ascii_digit())
+        {
+            return Some(token.to_string());
+        }
+    }
+    for token in description.split_whitespace() {
+        if token.len() == 12 && token.is_ascii() && token[..2].eq_ignore_ascii_case("br") {
+            let issuer = &token[2..6];
+            let class = token[6..11].to_ascii_lowercase();
+            if !issuer.chars().all(|c| c.is_ascii_alphabetic()) {
+                continue;
+            }
+            let suffix = match class.as_str() {
+                "acnor" => '3',
+                "acnpr" => '4',
+                _ => continue,
+            };
+            return Some(format!("{}{suffix}", issuer.to_ascii_uppercase()));
+        }
+    }
+    None
+}
+
+fn parse_income_entries(items: &[Value]) -> Vec<IncomeEntry> {
+    let categories: std::collections::HashMap<&str, &str> = items
+        .iter()
+        .filter(|item| item.get("resource").and_then(Value::as_str) == Some("category"))
+        .filter_map(|item| item.get("payload"))
+        .filter_map(|payload| {
+            Some((
+                payload.get("source_id")?.as_str()?,
+                payload.get("name")?.as_str()?,
+            ))
+        })
+        .collect();
+    items
+        .iter()
+        .filter(|item| item.get("resource").and_then(Value::as_str) == Some("cash_entry"))
+        .filter_map(|item| {
+            let key = item.get("source_id").and_then(Value::as_str)?;
+            let payload = item.get("payload")?;
+            if payload.get("status").and_then(Value::as_str) != Some("realizado")
+                || payload.get("entry_type").and_then(Value::as_str) != Some("receita")
+            {
+                return None;
+            }
+            let category = categories.get(payload.get("category_id")?.as_str()?)?;
+            if !is_income_category(category) {
+                return None;
+            }
+            let date = NaiveDate::parse_from_str(
+                payload.get("realized_date")?.as_str()?,
+                "%Y-%m-%d",
+            )
+            .ok()?;
+            let amount = payload.get("realized_amount")?.as_str()?.parse::<Decimal>().ok()?;
+            let description = payload
+                .get("description")
+                .and_then(Value::as_str)
+                .unwrap_or_default();
+            Some(IncomeEntry {
+                key: key.to_string(),
+                account_source_id: payload.get("account_id")?.as_str()?.to_string(),
+                date,
+                amount,
+                currency: payload
+                    .get("currency")
+                    .and_then(Value::as_str)
+                    .unwrap_or("BRL")
+                    .to_string(),
+                kind: income_kind(description),
+                symbol: ticker_from_description(description),
+                description: description.to_string(),
+            })
+        })
+        .collect()
+}
+
+fn income_activity_json(entry: &IncomeEntry, account_id: &str) -> Value {
+    let mut activity = serde_json::json!({
+        "accountId": account_id,
+        "activityType": entry.kind.activity_type(),
+        "activityDate": format!("{}T12:00:00.000Z", entry.date),
+        "currency": entry.currency,
+        "amount": entry.amount.to_string(),
+        "status": "POSTED",
+        "notes": format!("CB: {}", entry.description),
+        "sourceSystem": CB_SOURCE_SYSTEM,
+        "sourceRecordId": entry.key,
+        "idempotencyKey": entry.key,
+    });
+    if let Some(symbol) = &entry.symbol {
+        activity["asset"] = serde_json::json!({ "symbol": symbol, "exchangeMic": B3_MIC });
+    }
+    activity
+}
+
+fn income_activity_matches(activity: &Activity, entry: &IncomeEntry, account_id: &str) -> bool {
+    activity.account_id == account_id
+        && activity.activity_type == entry.kind.activity_type()
+        && activity.amount == Some(entry.amount)
+        && activity.currency == entry.currency
+        && activity.activity_date.date_naive() == entry.date
+}
+
+/// Mirrors the CB's dividend, JCP and share-lending credits as income
+/// activities on the account that received them. The CB stays the owner of the
+/// cash: these activities carry no balance (the accounts are in holdings mode).
+/// Only activities this importer created (source system and idempotency key)
+/// are ever changed. Returns (created, removed).
+async fn sync_cb_income(
+    state: &AppState,
+    entries: &[IncomeEntry],
+    accounts: &std::collections::HashMap<String, String>,
+) -> Result<(usize, usize), String> {
+    let account_ids: Vec<String> = accounts.values().cloned().collect();
+    let existing: Vec<Activity> = state
+        .activity_service
+        .get_activities_by_account_ids(&account_ids)
+        .map_err(|_| "Não foi possível ler as atividades existentes.".to_string())?
+        .into_iter()
+        .filter(|activity| activity.source_system.as_deref() == Some(CB_SOURCE_SYSTEM))
+        .collect();
+
+    let mut desired: std::collections::HashMap<&str, (&IncomeEntry, &str)> =
+        std::collections::HashMap::new();
+    for entry in entries {
+        let Some(account_id) = accounts.get(&entry.account_source_id) else {
+            continue;
+        };
+        // A dividend needs the asset it came from; without a ticker it is skipped.
+        if entry.kind == IncomeKind::Dividend && entry.symbol.is_none() {
+            continue;
+        }
+        desired.insert(entry.key.as_str(), (entry, account_id.as_str()));
+    }
+
+    let mut kept: BTreeSet<String> = BTreeSet::new();
+    let mut removed = 0;
+    for activity in &existing {
+        let key = activity.idempotency_key.as_deref();
+        let unchanged = key
+            .and_then(|key| desired.get(key))
+            .is_some_and(|(entry, account_id)| income_activity_matches(activity, entry, account_id));
+        if unchanged {
+            if let Some(key) = key {
+                kept.insert(key.to_string());
+            }
+            continue;
+        }
+        state
+            .activity_service
+            .delete_activity(activity.id.clone())
+            .await
+            .map_err(|_| "Não foi possível remover uma atividade desatualizada.".to_string())?;
+        removed += 1;
+    }
+
+    let mut created = 0;
+    for (key, (entry, account_id)) in &desired {
+        if kept.contains(*key) {
+            continue;
+        }
+        let new_activity: NewActivity =
+            serde_json::from_value(income_activity_json(entry, account_id))
+                .map_err(|_| "Atividade de renda do CB inválida.".to_string())?;
+        match state.activity_service.create_activity(new_activity).await {
+            Ok(_) => created += 1,
+            Err(_) => tracing::warn!("Patrimonio sync: could not create one CB income activity"),
+        }
+    }
+    Ok((created, removed))
+}
