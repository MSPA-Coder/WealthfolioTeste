+/// A market-value change of the CB (`valuation` category) as one activity.
+///
+/// The balance of the account moves, but no money crossed its boundary: a
+/// DEPOSIT or WITHDRAWAL would be an external flow and a net contribution, and
+/// the gain or loss would vanish from the returns. A gain is a CREDIT without
+/// subtype (adds cash, no contribution, not income). A loss has no neutral cash
+/// type in Wealthfolio, so it is a FEE: it lowers cash and the return, and is
+/// the only internal outflow; it is reported as a charge, which it is not.
+/// Neither gets a spending or income category: it is not spending nor income.
+pub(super) fn valuation_activity(entry: &LedgerEntry, account_id: &str) -> Desired {
+    let activity_type = if entry.income { "CREDIT" } else { "FEE" };
+    let json = base_json(
+        &entry.key,
+        account_id,
+        activity_type,
+        entry.date,
+        &entry.currency,
+        entry.amount,
+        format!("CB: {}", entry.description),
+    );
+    Desired {
+        key: entry.key.clone(),
+        account_id: account_id.to_string(),
+        activity_type: activity_type.to_string(),
+        amount: entry.amount,
+        currency: entry.currency.clone(),
+        date: entry.date,
+        group_id: None,
+        json,
+        category: None,
+    }
+}
