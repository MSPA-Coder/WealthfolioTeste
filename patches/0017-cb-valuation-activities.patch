+    #[test]
+    fn a_market_value_change_is_return_not_a_capital_move_nor_spending() {
+        let gain = valuation_activity(
+            &entry("v1", true, false, "300.00", "Atualização de saldo: marcação a mercado"),
+            "wf",
+        );
+        // Neutral cash credit: no contribution, not income, no category.
+        assert_eq!(gain.activity_type, "CREDIT");
+        assert!(gain.json.get("subtype").is_none());
+        assert!(gain.category.is_none());
+        assert_eq!(cash_effect(&gain), dec("300.00"));
+
+        let loss = valuation_activity(
+            &entry("v2", false, false, "120.00", "Atualização de saldo: marcação a mercado"),
+            "wf",
+        );
+        // Never a WITHDRAWAL (an external flow that would hide the loss).
+        assert_eq!(loss.activity_type, "FEE");
+        assert!(loss.category.is_none());
+        assert_eq!(cash_effect(&loss), dec("-120.00"));
+    }
+
