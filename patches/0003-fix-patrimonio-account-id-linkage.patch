r,     provider: &str,     account_type: &str,     tracking_mode: TrackingMode,-) -> Result<(), String> {+) -> Result<String, String> {     let meta = serde_json::json!({ "sourceId": source_id, "sourceSystem": provider }).to_string();     let existing = state         .account_service         .get_all_accounts()         .map_err(|_| "Não foi possível consultar as contas locais.".to_string())?         .into_iter()-        .find(|account| account.id == id);+        .find(|account| {+            account.provider.as_deref() == Some(provider)+                && account.provider_account_id.as_deref() == Some(source_id)+        });      if let Some(existing) = existing {-        if existing.provider.as_deref() != Some(provider)-            || existing.provider_account_id.as_deref() != Some(source_id)-        {-            return Err("O identificador de uma conta importada já está em uso.".into());-        }-        state+        let id = existing.id.clone();+        let updated = state             .account_service             .update_account(AccountUpdate {-                id: Some(id.to_string()),+                id: Some(id),                 name: name.to_string(),                 account_type: account_type.to_string(),                 group: existing.group,@@ -385,11 +380,12 @@ async fn ensure_source_account(             })             .await             .map_err(|_| "Não foi possível atualizar a conta importada.".to_string())?;+        Ok(updated.id)     } else {-        state+        let created = state             .account_service             .create_account(NewAccount {-                id: Some(id.to_string()),+                id: Some(stable_id("patrimonio", &format!("{provider}:{source_id}"))),                 name: name.to_string(),                 account_type: account_type.to_string(),                 group: None,@@ -406,8 +402,8 @@ async fn ensure_source_account(             })             .await             .map_err(|_| "Não foi possível criar a conta importada.".to_string())?;+        Ok(created.id)     }-    Ok(()) }  async fn save_source_snapshot(-- 2.55.0.windows.5