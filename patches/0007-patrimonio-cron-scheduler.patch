+#[derive(Clone, Debug, PartialEq, Eq)]
+struct CronField {
+    any: bool,
+    values: BTreeSet<u32>,
+}
+
+impl CronField {
+    fn matches(&self, value: u32) -> bool {
+        self.any || self.values.contains(&value)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct CronSchedule {
+    minute: CronField,
+    hour: CronField,
+    day_of_month: CronField,
+    month: CronField,
+    weekday: CronField,
+}
+
+impl CronSchedule {
+    fn matches(&self, now: chrono::DateTime<chrono_tz::Tz>) -> bool {
+        if !self.minute.matches(now.minute())
+            || !self.hour.matches(now.hour())
+            || !self.month.matches(now.month())
+        {
+            return false;
+        }
+
+        let day_of_month_matches = self.day_of_month.matches(now.day());
+        let weekday_matches = self.weekday.matches(now.weekday().num_days_from_sunday());
+        match (self.day_of_month.any, self.weekday.any) {
+            (false, false) => day_of_month_matches || weekday_matches,
+            _ => day_of_month_matches && weekday_matches,
+        }
+    }
+}
+
+fn parse_cron_field(
+    raw: &str,
+    minimum: u32,
+    maximum: u32,
+    weekday: bool,
+) -> Result<CronField, String> {
+    let raw = raw.trim();
+    if raw == "*" {
+        return Ok(CronField {
+            any: true,
+            values: BTreeSet::new(),
+        });
+    }
+
+    let mut values = BTreeSet::new();
+    for item in raw.split(',') {
+        let (range, step) = match item.split_once('/') {
+            Some((range, step)) => {
+                let step = step
+                    .parse::<u32>()
+                    .map_err(|_| format!("cron inválido: passo `{step}` inválido"))?;
+                if step == 0 {
+                    return Err("cron inválido: o passo não pode ser zero".into());
+                }
+                (range, step)
+            }
+            None => (item, 1),
+        };
+        let (start, end) = if range == "*" {
+            (minimum, maximum)
+        } else if let Some((start, end)) = range.split_once('-') {
+            (
+                parse_cron_value(start, minimum, maximum)?,
+                parse_cron_value(end, minimum, maximum)?,
+            )
+        } else {
+            let value = parse_cron_value(range, minimum, maximum)?;
+            (value, value)
+        };
+        if start > end {
+            return Err("cron inválido: intervalo decrescente".into());
+        }
+        for value in (start..=end).step_by(step as usize) {
+            values.insert(if weekday && value == 7 { 0 } else { value });
+        }
+    }
+    if values.is_empty() {
+        return Err("cron inválido: campo vazio".into());
+    }
+    Ok(CronField { any: false, values })
+}
+
+fn parse_cron_value(raw: &str, minimum: u32, maximum: u32) -> Result<u32, String> {
+    let value = raw
+        .parse::<u32>()
+        .map_err(|_| format!("cron inválido: valor `{raw}` inválido"))?;
+    if !(minimum..=maximum).contains(&value) {
+        return Err(format!(
+            "cron inválido: `{raw}` fora do intervalo {minimum}-{maximum}"
+        ));
+    }
+    Ok(value)
+}
+
+/// Parses a five-field cron schedule: minute, hour, day-of-month, month and
+/// weekday. It supports `*`, comma-separated values, ranges and `/step`; 0 and
+/// 7 both mean Sunday. The schedule is always evaluated in America/Sao_Paulo.
+fn parse_cron(raw: &str) -> Result<CronSchedule, String> {
+    let fields = raw.split_whitespace().collect::<Vec<_>>();
+    if fields.len() != 5 {
+        return Err("cron inválido: use cinco campos (minuto hora dia mês dia-da-semana)".into());
+    }
+    Ok(CronSchedule {
+        minute: parse_cron_field(fields[0], 0, 59, false)?,
+        hour: parse_cron_field(fields[1], 0, 23, false)?,
+        day_of_month: parse_cron_field(fields[2], 1, 31, false)?,
+        month: parse_cron_field(fields[3], 1, 12, false)?,
+        weekday: parse_cron_field(fields[4], 0, 7, true)?,
+    })
+}
+
+enum Schedule {
+    Cron(CronSchedule),
+    Interval(Duration),
+}
+
+fn configured_schedule() -> Result<Option<Schedule>, String> {
+    if let Ok(raw) = std::env::var(CRON_ENV) {
+        if !raw.trim().is_empty() {
+            return parse_cron(&raw).map(Schedule::Cron).map(Some);
+        }
+    }
+    Ok(parse_interval(std::env::var(INTERVAL_ENV).ok().as_deref()).map(Schedule::Interval))
+}
